 {
  "type": "npc",
  "id": "trl_nc_bratva_contact",
  "class": "trl_nc_bratva_contact",
  "attitude": 0,
  "mission": 7,
  "faction": "trl_bratva",
  "chat": "TRL_CONTACT_BRATVA",
  "temp_suffix": "Bratva contact"
 },
 {
  "type": "talk_topic",
  "id": "TRL_CONTACT_BRATVA",
  "dynamic_line": {
   "math": [
    "trl_rank_bratva <= -4"
   ],
   "yes": "I don't talk to you.  Leave before somebody gets hurt.",
   "no": {
    "math": [
     "trl_rank_bratva <= 0"
    ],
    "yes": "A stranger.  Buy a drink or move along.",
    "no": {
     "math": [
      "trl_rank_bratva <= 3"
     ],
     "yes": "You again.  You keep your head down, which I like.",
     "no": "Good to see you.  Sit.  What do you need?"
    }
   }
  },
  "responses": [
   {
    "text": "I'm looking for work.",
    "topic": "TRL_CONTACT_BRATVA_WORK",
    "condition": {
     "math": [
      "trl_rank_bratva > -4"
     ]
    }
   },
   {
    "text": "Where do I stand with you?",
    "topic": "TRL_CONTACT_BRATVA_STAND"
   },
   {
    "text": "Never mind.",
    "topic": "TALK_DONE"
   }
  ]
 },
 {
  "type": "talk_topic",
  "id": "TRL_CONTACT_BRATVA_WORK",
  "dynamic_line": {
   "math": [
    "trl_rank_bratva <= 0"
   ],
   "yes": "Nothing for strangers.  Do something useful first.",
   "no": "Nothing right now.  Come back when the city's quiet."
  },
  "responses": [
   {
    "text": "Alright.",
    "topic": "TALK_DONE"
   }
  ]
 },
 {
  "type": "talk_topic",
  "id": "TRL_CONTACT_BRATVA_STAND",
  "dynamic_line": {
   "math": [
    "trl_rank_bratva <= -7"
   ],
   "yes": "Enemy.",
   "no": {
    "math": [
     "trl_rank_bratva <= -4"
    ],
    "yes": "Hostile.  Don't push it.",
    "no": {
     "math": [
      "trl_rank_bratva <= -1"
     ],
     "yes": "Unfriendly.  I wouldn't trust you with a coat.",
     "no": {
      "math": [
       "trl_rank_bratva == 0"
      ],
      "yes": "Neutral.  You are nobody to me.",
      "no": {
       "math": [
        "trl_rank_bratva <= 3"
       ],
       "yes": "Tolerated.  You can trade here.",
       "no": {
        "math": [
         "trl_rank_bratva <= 6"
        ],
        "yes": "Friendly.  People here like you.",
        "no": {
         "math": [
          "trl_rank_bratva <= 9"
         ],
         "yes": "Trusted.  You're one of ours, almost.",
         "no": "Inner circle."
        }
       }
      }
     }
    }
   }
  },
  "responses": [
   {
    "text": "Fair enough.",
    "topic": "TALK_DONE"
   }
  ]
 },
