 {
  "type": "effect_on_condition",
  "id": "trl_fac_start",
  "effect": [
   {
    "set_string_var": "none",
    "target_var": {
     "global_val": "trl_victim_faction"
    }
   },
   {
    "math": [
     "trl_rank_bratva = -6"
    ]
   },
   {
    "math": [
     "trl_rank_jsdf = 0"
    ]
   },
   {
    "math": [
     "trl_rank_nasim = 0"
    ]
   },
   {
    "if": {
     "u_has_trait": "trl_align_jsdf"
    },
    "then": [
     {
      "math": [
       "trl_rank_bratva = -8"
      ]
     },
     {
      "math": [
       "trl_rank_jsdf = 4"
      ]
     }
    ]
   },
   {
    "if": {
     "u_has_trait": "trl_align_bratva"
    },
    "then": [
     {
      "math": [
       "trl_rank_bratva = 4"
      ]
     },
     {
      "math": [
       "trl_rank_jsdf = -8"
      ]
     }
    ]
   },
   {
    "run_eocs": [
     "trl_fac_sync"
    ]
   }
  ]
 },
 {
  "type": "effect_on_condition",
  "id": "trl_fac_sync",
  "recurrence": [
   "30 seconds",
   "30 seconds"
  ],
  "global": true,
  "effect": [
   {
    "math": [
     "trl_eff_bratva = trl_rank_bratva"
    ]
   },
   {
    "math": [
     "trl_rank_bratva = max(-10, min(10, trl_rank_bratva))"
    ]
   },
   {
    "math": [
     "faction_like('trl_bratva') = 3 * trl_eff_bratva"
    ]
   },
   {
    "math": [
     "faction_respect('trl_bratva') = 3 * trl_eff_bratva"
    ]
   },
   {
    "math": [
     "trl_eff_jsdf = trl_rank_jsdf"
    ]
   },
   {
    "math": [
     "trl_rank_jsdf = max(-10, min(10, trl_rank_jsdf))"
    ]
   },
   {
    "math": [
     "faction_like('trl_jsdf') = 3 * trl_eff_jsdf"
    ]
   },
   {
    "math": [
     "faction_respect('trl_jsdf') = 3 * trl_eff_jsdf"
    ]
   },
   {
    "if": {
     "and": [
      {
       "u_has_bionics": "ANY"
      },
      {
       "math": [
        "trl_rank_nasim < 7"
       ]
      }
     ]
    },
    "then": [
     {
      "math": [
       "trl_eff_nasim = min(trl_rank_nasim, -6)"
      ]
     }
    ],
    "else": [
     {
      "math": [
       "trl_eff_nasim = trl_rank_nasim"
      ]
     }
    ]
   },
   {
    "math": [
     "trl_rank_nasim = max(-10, min(10, trl_rank_nasim))"
    ]
   },
   {
    "math": [
     "faction_like('trl_nasim') = 3 * trl_eff_nasim"
    ]
   },
   {
    "math": [
     "faction_respect('trl_nasim') = 3 * trl_eff_nasim"
    ]
   }
  ]
 },
 {
  "type": "effect_on_condition",
  "id": "trl_fac_kill",
  "eoc_type": "EVENT",
  "required_event": "character_kills_character",
  "effect": [
   {
    "if": {
     "compare_string": [
      "trl_bratva",
      {
       "global_val": "trl_victim_faction"
      }
     ]
    },
    "then": [
     {
      "math": [
       "trl_rank_bratva = trl_rank_bratva - 2"
      ]
     },
     {
      "math": [
       "trl_rank_jsdf = trl_rank_jsdf + 1"
      ]
     },
     {
      "math": [
       "trl_rank_nasim = trl_rank_nasim + 1"
      ]
     }
    ]
   },
   {
    "if": {
     "compare_string": [
      "trl_jsdf",
      {
       "global_val": "trl_victim_faction"
      }
     ]
    },
    "then": [
     {
      "math": [
       "trl_rank_jsdf = trl_rank_jsdf - 2"
      ]
     },
