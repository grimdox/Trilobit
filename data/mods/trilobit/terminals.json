  {
    "type": "effect_on_condition",
    "id": "trl_spy_probe",
    "effect": [
      {
        "u_location_variable": {
          "global_val": "trl_spy_sloc"
        }
      },
      {
        "if": "player_see_u",
        "then": {
          "math": [
            "trl_spy_see",
            "=",
            "1"
          ]
        }
      },
      {
        "if": {
          "u_can_see_location": {
            "global_val": "trl_spy_ploc"
          }
        },
        "then": {
          "math": [
            "trl_spy_spotted",
            "=",
            "1"
          ]
        }
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "trl_spy_tick",
    "eoc_type": "RECURRING",
    "recurrence": "1 seconds",
    "global": true,
    "condition": {
      "and": [
        {
          "math": [
            "trl_t_state == 3"
          ]
        },
        {
          "math": [
            "trl_spy_progress < 10"
          ]
        }
      ]
    },
    "effect": [
      {
        "math": [
          "trl_spy_see",
          "=",
          "0"
        ]
      },
      {
        "math": [
          "trl_spy_spotted",
          "=",
          "0"
        ]
      },
      {
        "u_location_variable": {
          "global_val": "trl_spy_ploc"
        }
      },
      {
        "u_run_npc_eocs": [
          "trl_spy_probe"
        ],
        "unique_ids": [
          "trl_t_uid_subject"
        ]
      },
      {
        "if": {
          "and": [
            {
              "math": [
                "trl_spy_spotted == 1"
              ]
            },
            {
              "math": [
                "trl_spy_progress > 0"
              ]
            }
          ]
        },
        "then": [
          {
            "math": [
              "trl_spy_progress",
              "=",
              "0"
            ]
          },
          {
            "u_message": "[Trilobit] The subject spotted you.  Observation reset.",
            "type": "bad"
          }
        ]
      },
      {
        "if": {
          "and": [
            {
              "math": [
                "trl_spy_see == 1"
              ]
            },
            {
              "math": [
                "trl_spy_spotted == 0"
              ]
            },
            {
              "math": [
                "distance('u', trl_spy_sloc) >= 10"
              ]
            }
          ]
        },
        "then": [
          {
            "math": [
              "trl_spy_progress",
              "+=",
              "1"
            ]
          },
          {
            "u_message": "[Trilobit] Observing the subject: <global_val:trl_spy_progress>/10",
            "type": "neutral"
          }
        ]
      }
    ]
  },
