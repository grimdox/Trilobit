  "price_postapoc": "120 USD",
  "use_action": {
   "type": "effect_on_conditions",
   "menu_text": "Eat",
   "description": "Eat this cyber ration.",
   "effect_on_conditions": [
    "trl_cf_eat_nutrient_paste"
   ]
  }
 },
 {
  "type": "effect_on_condition",
  "id": "trl_cf_eat_nutrient_paste",
  "effect": [
   {
    "if": {
     "u_has_bionics": "trl_imp_stomach"
    },
    "then": [
     {
      "u_message": "You swallow the nutrient paste tube.  It is rich, complete and very, very good.",
      "type": "good"
     },
     {
      "math": [
       "u_calories()",
       "=",
       "u_calories() + 900"
      ]
     },
     {
      "math": [
       "u_val('thirst')",
       "=",
       "max(u_val('thirst') - 20, -60)"
      ]
     },
     {
      "u_add_morale": "morale_food_good",
      "bonus": 5,
      "max_bonus": 10,
      "duration": "3 hours",
      "decay_start": "1 hours"
     },
     {
      "math": [
       "u_val('power')",
       "=",
       "min(u_val('power') + 30000000, u_val('power_max'))"
      ]
     }
    ],
    "else": [
     {
      "u_message": "Your stomach cannot digest nutrient paste tube: you need a cyberstomach.  It is back in your pack.",
      "type": "bad"
     },
     {
      "u_spawn_item": "trl_cf_nutrient_paste"
     }
    ]
   }
  ]
 },
