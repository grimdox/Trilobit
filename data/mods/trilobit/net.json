 {
  "type": "effect_on_condition",
  "id": "trl_net_jack_in",
  "effect": [
   {
    "if": {
     "u_has_flag": "MACHINE_BRAIN"
    },
    "then": [
     {
      "run_eocs": [
       "trl_net_jack_in2"
      ]
     }
    ],
    "else": [
     {
      "u_message": "You need a cyberbrain to log in.",
      "type": "bad"
     }
    ]
   }
  ]
 },
 {
  "type": "effect_on_condition",
  "id": "trl_net_jack_in2",
  "effect": [
   {
    "u_location_variable": {
     "global_val": "trl_net_return"
    }
   },
   {
    "u_location_variable": {
     "global_val": "trl_net_loc"
    },
    "z_adjust": -10,
    "z_override": true
   },
   {
    "mapgen_update": "trl_net_room",
    "target_var": {
     "global_val": "trl_net_loc"
    }
   },
   {
    "u_teleport": {
     "global_val": "trl_net_start"
    },
    "fail_message": "The login fails; the Net is closed to you."
   },
   {
    "u_message": "[Net] Your senses wash out into green and teal light.  You are logged in.",
    "type": "good"
   }
  ]
 },
 {
  "type": "effect_on_condition",
  "id": "trl_net_exit",
  "effect": [
   {
    "u_teleport": {
     "global_val": "trl_net_return"
    },
    "fail_message": "The gate will not open."
   },
   {
    "u_message": "[Net] The light drains away and you are back in your body.",
    "type": "info"
   }
  ]
 },
 {
  "type": "effect_on_condition",
  "id": "trl_net_node_hack",
  "effect": [
   {
    "if": {
     "math": [
      "time('now') >= trl_net_node_ready"
     ]
    },
    "then": [
     {
      "run_eocs": [
       "trl_net_node_hack2"
      ]
     }
    ],
    "else": [
     {
      "u_message": "[Net] The node is still cooling down.",
      "type": "info"
     }
    ]
   }
  ]
 },
 {
  "type": "effect_on_condition",
  "id": "trl_net_node_hack2",
  "effect": [
   {
    "math": [
     "u_net_gain = 150 + (u_skill('computer') + 1) * (50 + rand(100))"
    ]
   },
   {
    "math": [
     "trl_bank += u_net_gain"
    ]
   },
   {
    "math": [
     "trl_net_node_ready = time('now') + time('10 m')"
    ]
   },
   {
    "u_message": "[Net] You crack the node: <u_val:net_gain> yen credited.  Balance: <global_val:trl_bank> yen.",
    "type": "good"
   }
  ]
 },
 {
  "type": "effect_on_condition",
  "id": "trl_net_init",
  "effect": [
   {
    "math": [
     "trl_net_node_ready = 0"
    ]
   }
  ]
 }
]