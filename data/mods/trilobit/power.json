[
 {
  "type": "effect_on_condition",
  "id": "trl_rc_p_25",
  "effect": [
   {
    "if": {
     "math": [
      "u_val('power_max')",
      "<=",
      "0"
     ]
    },
    "then": [
     {
      "u_message": "You have no bionic power storage to charge.",
      "type": "info"
     }
    ],
    "else": [
     {
      "if": {
       "math": [
        "u_item_count('trl_yen')",
        "<",
        "160"
       ]
      },
      "then": [
       {
        "u_message": "The post wants 160 yen.",
        "type": "bad"
       }
      ],
      "else": [
       {
        "u_consume_item": "trl_yen",
        "count": 160
       },
       {
        "math": [
         "u_val('power')",
         "=",
         "min(u_val('power') + u_val('power_max') * 25 / 100, u_val('power_max'))"
        ]
       },
       {
        "u_message": "The post hums.  Your implants drink the charge.",
        "type": "good"
       }
      ]
     }
    ]
   }
  ]
 },
