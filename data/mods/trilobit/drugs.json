 {
  "type": "ITEM",
  "subtypes": [
   "GENERIC"
  ],
  "id": "trl_inj_regen",
  "category": "drugs",
  "name": {
   "str": "regen stimulant injector"
  },
  "description": "A spring-loaded auto-injector of military-grade regenerative nanites.  Press it to your thigh: over the next hour it knits your own flesh back together, restoring about half of your health a little at a time.  Not instant.  It cannot repair implants.  Issued to hospitals and police; never sold.",
  "weight": "30 g",
  "volume": "30 ml",
  "price": "900 USD",
  "price_postapoc": "900 USD",
  "symbol": "!",
  "color": "light_green",
  "material": [
   "plastic"
  ],
  "flags": [
   "TRADER_AVOID"
  ],
  "use_action": {
   "type": "effect_on_conditions",
   "menu_text": "Inject",
   "description": "Inject the regen stimulant.",
   "effect_on_conditions": [
    "trl_regen_inject"
   ]
  }
 },
 {
  "type": "effect_on_condition",
  "id": "trl_regen_inject",
  "effect": [
   {
    "u_consume_item": "trl_inj_regen",
    "count": 1
   },
   {
    "u_add_effect": "effect_trl_regen",
    "duration": "1 hours"
   },
   {
    "run_eocs": [
     "trl_regen_reset"
    ]
   },
   {
    "u_message": "You press the injector to your thigh.  It clicks, and a cool warmth spreads outward.",
    "type": "good"
   }
  ]
 },
 {
  "type": "effect_on_condition",
  "id": "trl_regen_reset",
  "effect": [
   {
    "math": [
     "u_trl_regen_acc_head = 0"
    ]
   },
   {
    "math": [
     "u_trl_regen_acc_torso = 0"
    ]
   },
   {
    "math": [
     "u_trl_regen_acc_arm_l = 0"
    ]
   },
   {
    "math": [
     "u_trl_regen_acc_arm_r = 0"
    ]
   },
   {
    "math": [
     "u_trl_regen_acc_leg_l = 0"
    ]
   },
   {
    "math": [
     "u_trl_regen_acc_leg_r = 0"
    ]
   }
  ]
 },
 {
  "type": "effect_on_condition",
  "id": "trl_regen_tick",
  "recurrence": "1 minutes",
  "global": true,
  "condition": {
   "u_has_effect": "effect_trl_regen"
  },
  "effect": [
   {
    "math": [
     "u_trl_regen_acc_head += u_hp_max('head') * 0.008333"
    ]
   },
   {
    "math": [
     "u_trl_regen_add = floor(u_trl_regen_acc_head)"
    ]
   },
   {
    "math": [
     "u_trl_regen_acc_head -= u_trl_regen_add"
    ]
   },
   {
    "math": [
     "u_hp('head') = min(u_hp('head') + u_trl_regen_add, u_hp_max('head'))"
    ]
   },
