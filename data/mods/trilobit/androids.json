 {
  "type": "effect_on_condition",
  "id": "trl_andr_tick",
  "recurrence": [
   "15 minutes",
   "20 minutes"
  ],
  "global": true,
  "effect": [
   {
    "u_run_npc_eocs": [
     "trl_andr_step"
    ],
    "overmap": true
   }
  ]
 },
 {
  "type": "effect_on_condition",
  "id": "trl_andr_step",
  "condition": {
   "and": [
    {
     "u_has_trait": "trl_android"
    },
    {
     "not": "u_following"
    },
    {
     "math": [
      "u_trl_skip_until < time('now')"
     ]
    }
   ]
  },
  "effect": [
   {
    "run_eocs": [
     "trl_andr_init_once"
    ]
   },
   {
    "if": {
     "or": [
      {
       "math": [
        "u_npc_anger() > 0"
       ]
      },
      {
       "math": [
        "u_npc_fear() > 0"
       ]
      }
     ]
    },
    "then": [
     {
      "math": [
       "u_trl_skip_until = time('now') + time('10 m')"
      ]
     }
    ],
    "else": [
     {
      "run_eocs": [
       "trl_andr_battery"
      ]
     },
     {
      "if": {
       "math": [
        "u_andr_battery <= 0"
       ]
      },
      "then": [
       {
        "u_add_effect": "stunned",
        "duration": "20 minutes"
       }
      ],
      "else": [
       {
        "if": {
         "math": [
          "u_andr_charging == 1"
         ]
        },
        "then": [
         {
          "run_eocs": [
           "trl_andr_charge"
          ]
         }
        ],
        "else": [
         {
          "if": {
           "u_has_trait": "trl_andr_role_porter"
          },
          "then": [
           {
            "run_eocs": [
             "trl_andr_roam"
            ]
           }
          ],
          "else": [
           {
            "run_eocs": [
             "trl_andr_post"
            ]
           }
          ]
         }
        ]
       }
      ]
     }
    ]
   }
  ]
 },
 {
  "type": "effect_on_condition",
  "id": "trl_andr_init_once",
  "condition": {
   "math": [
    "u_andr_inited == 0"
   ]
  },
  "effect": [
   {
    "u_location_variable": {
     "u_val": "andr_dock"
    }
   },
   {
    "math": [
     "u_andr_inited = 1"
    ]
   },
   {
    "math": [
     "u_andr_battery = 100"
    ]
   },
   {
    "math": [
     "u_andr_charging = 0"
    ]
   }
  ]
 },
 {
  "type": "effect_on_condition",
  "id": "trl_andr_battery",
  "effect": [
   {
    "if": {
     "math": [
      "u_andr_charging == 0"
     ]
    },
    "then": [
     {
      "math": [
       "u_andr_battery = max(0, u_andr_battery - 2)"
      ]
     }
    ]
   },
   {
    "if": {
     "and": [
      {
       "math": [
        "u_andr_charging == 0"
       ]
      },
      {
       "math": [
        "u_andr_battery <= 15"
       ]
      }
     ]
    },
    "then": [
     {
      "math": [
       "u_andr_charging = 1"
      ]
     },
     {
      "u_go_to_loc": {
       "u_val": "andr_dock"
      }
     }
    ]
   }
  ]
 },
 {
  "type": "effect_on_condition",
  "id": "trl_andr_charge",
  "effect": [
   {
    "if": {
     "math": [
      "distance('u', u_andr_dock) > 2"
     ]
    },
    "then": [
     {
      "u_go_to_loc": {
       "u_val": "andr_dock"
      }
     }
    ],
    "else": [
     {
      "math": [
       "u_andr_battery = min(100, u_andr_battery + 12)"
      ]
     }
    ]
   },
   {
    "if": {
     "math": [
      "u_andr_battery >= 95"
     ]
    },
    "then": [
     {
      "math": [
       "u_andr_charging = 0"
      ]
     }
    ]
   }
  ]
 },
 {
  "type": "effect_on_condition",
  "id": "trl_andr_post",
  "effect": [
   {
    "if": {
     "math": [
      "distance('u', u_andr_dock) > 3"
     ]
    },
    "then": [
     {
      "u_go_to_loc": {
       "u_val": "andr_dock"
      }
     }
    ]
   }
  ]
 },
 {
  "type": "effect_on_condition",
  "id": "trl_andr_goto_spot",
  "effect": [
   {
    "u_go_to_loc": {
     "u_val": "andr_spot"
    }
   }
  ]
 },
 {
  "type": "effect_on_condition",
  "id": "trl_andr_roam",
  "effect": [
   {
    "if": {
     "or": [
      {
       "math": [
        "distance('u', u_andr_dock) > 12"
       ]
      },
      {
       "math": [
        "rand(4) == 0"
       ]
      }
     ]
    },
    "then": [
     {
      "u_go_to_loc": {
       "u_val": "andr_dock"
      }
     }
    ],
    "else": [
     {
      "u_location_variable": {
       "u_val": "andr_spot"
      },
      "max_radius": 8,
      "passable_only": true,
      "true_eocs": [
       "trl_andr_goto_spot"
      ]
     }
    ]
   }
  ]
 },
