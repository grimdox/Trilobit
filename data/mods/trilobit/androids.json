      {
       "math": [
        "u_andr_battery <= 15"
       ]
      }
     ]
    },
    "then": [
     {
      "math": [
       "u_andr_charging = 1"
      ]
     },
     {
      "u_go_to_loc": {
       "u_val": "andr_dock"
      }
     }
    ]
   }
  ]
 },
 {
  "type": "effect_on_condition",
  "id": "trl_andr_charge",
  "effect": [
   {
    "if": {
     "math": [
      "distance('u', u_andr_dock) > 2"
     ]
    },
    "then": [
     {
      "u_go_to_loc": {
       "u_val": "andr_dock"
      }
     }
    ],
    "else": [
     {
      "math": [
       "u_andr_battery = min(100, u_andr_battery + 12)"
      ]
     }
    ]
   },
   {
    "if": {
     "math": [
      "u_andr_battery >= 95"
     ]
