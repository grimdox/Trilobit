 {
  "type": "talk_topic",
  "id": "TRL_ANDROID_TALK",
  "dynamic_line": {
   "u_has_trait": "trl_andr_role_guard",
   "yes": "Move along.  This area is monitored.",
   "no": {
    "u_has_trait": "trl_andr_role_porter",
    "yes": "Cargo goes where the list says.  Please keep clear.",
    "no": "Welcome.  How may I help you?"
   }
  },
  "responses": [
   {
    "text": "Never mind.",
    "topic": "TALK_DONE"
   }
  ]
 },
 {
  "type": "effect_on_condition",
  "id": "trl_andr_tick",
  "recurrence": [
   "15 minutes",
   "20 minutes"
  ],
  "global": true,
  "effect": [
   {
    "u_run_npc_eocs": [
     "trl_andr_step"
    ],
    "overmap": true
   }
  ]
 },
 {
  "type": "effect_on_condition",
  "id": "trl_andr_step",
  "condition": {
   "and": [
    {
     "u_has_trait": "trl_android"
    },
    {
     "not": "u_following"
    },
    {
     "math": [
      "u_trl_skip_until < time('now')"
     ]
    }
   ]
  },
  "effect": [
   {
    "run_eocs": [
     "trl_andr_init_once"
    ]
   },
   {
    "if": {
     "or": [
      {
       "math": [
        "u_npc_anger() > 0"
       ]
      },
      {
       "math": [
        "u_npc_fear() > 0"
       ]
      }
     ]
    },
    "then": [
     {
      "math": [
       "u_trl_skip_until = time('now') + time('10 m')"
      ]
     }
    ],
    "else": [
     {
      "run_eocs": [
       "trl_andr_battery"
      ]
     },
     {
      "if": {
